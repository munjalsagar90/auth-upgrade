<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mycompany</groupId>
    <artifactId>github-repo-setup</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>mule-application</packaging>

    <name>github-repo-setup</name>
    <description>
        MCP Server Template -- accepts a GitHub repository name via MCP Tool Listener,
        authenticates with GitHub, searches for the repository, creates a feature branch,
        and adds the MuleSoft SAP Connector dependency to the repository pom.xml.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <app.runtime>4.9.6</app.runtime>
        <mule.maven.plugin.version>4.3.0</mule.maven.plugin.version>
        <!-- Path to the folder containing SAP proprietary JARs (sapjco3.jar, sapidoc3.jar).
             Download these from SAP Service Marketplace (SAP ONE Support Launchpad)
             and place them in the project libs/ directory before building. -->
        <sap.libs.dir>${project.basedir}/libs</sap.libs.dir>
    </properties>

    <dependencies>
        <!-- MCP Connector - MCP Tool Listener (Streamable HTTP transport) -->
        <dependency>
            <groupId>com.mulesoft.connectors</groupId>
            <artifactId>mule-mcp-connector</artifactId>
            <version>1.3.1</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- HTTP Connector - GitHub API outbound requests -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>1.11.1</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- MuleSoft SAP Connector (Mule plugin) -->
      

        <!-- SAP JCo Library (sapjco3.jar)
             Source  : SAP Service Marketplace / SAP ONE Support Launchpad
             SAP Note: 1858741 (SAP Java Connector)
             Place   : ${project.basedir}/libs/sapjco3.jar
             Required: Message Server and Application Server connectivity -->
     

        <!-- SAP IDoc Library (sapidoc3.jar)
             Source  : SAP Service Marketplace / SAP ONE Support Launchpad
             SAP Note: 1858741
             Place   : ${project.basedir}/libs/sapidoc3.jar
             Required: IDoc document processing (Send / Receive) -->

        <!-- SAP JCo Native Library (libsapjco3.dll on Windows / libsapjco3.so on Linux)
             Source  : SAP Service Marketplace (same download as sapjco3.jar)
             Place   : Add the native library to the OS system PATH, OR copy to
                       ${project.basedir}/libs/ and add that directory to java.library.path
                       at runtime (e.g., -Djava.library.path=${project.basedir}/libs).
             NOTE    : Native libraries cannot be declared as Maven system-scope JARs;
                       they must be available on the system or JVM library path at runtime. -->

        <!-- MUnit for testing -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-runner</artifactId>
            <version>3.1.0</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-tools</artifactId>
            <version>3.1.0</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <classifier>mule-application</classifier>
                    <!-- Include system-scope SAP JARs in the deployable archive -->
                    <additionalPluginDependencies>
                      
                    </additionalPluginDependencies>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.mulesoft.munit.tools</groupId>
                <artifactId>munit-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                            <goal>coverage-report</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <coverage>
                        <runCoverage>true</runCoverage>
                        <formats>
                            <format>html</format>
                        </formats>
                    </coverage>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases-ee</id>
            <name>MuleSoft EE Releases Repository</name>
            <url>https://repository.mulesoft.org/nexus/content/repositories/releases-ee/</url>
            <layout>default</layout>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </pluginRepository>
    </pluginRepositories>
</project>